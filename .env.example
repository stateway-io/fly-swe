# Secrets for the issue-agent. Everything else (repos, budgets, worker
# tuning, retention, ...) lives in config.yaml — see the comments there.
# Precedence: env var > config.yaml > code default.

# Provider instance secrets: PROVIDERS__<ID>__<FIELD>, <ID> = the instance id
# under `providers:` in config.yaml, upper-cased. Never put these in config.yaml.
# GitHub App (instance `github`)
PROVIDERS__GITHUB__APP_PRIVATE_KEY_PATH=./secrets/issue-agent.YYYY-MM-DD.private-key.pem
PROVIDERS__GITHUB__WEBHOOK_SECRET=

# LLM
LLM_API_KEY=sk-or-v1-...
# Optional — key for the failover model (llm.fallback.model in config.yaml).
# Unset falls back to LLM_API_KEY.
LLM_FALLBACK_API_KEY=

# Alerts (optional — Discord/Telegram webhook for budget exceeded notifications)
# Discord: https://discord.com/api/webhooks/<id>/<token>
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
ALERT_WEBHOOK_URL=

# FLY_API_TOKEN is not a Settings field — it authenticates `flyctl` in the
# GitHub Actions deploy workflow. Set it as a GitHub Actions secret, not here.

# --- Test-only config (not part of Settings, see tests/e2e/conftest.py) ---
E2E_TEST_REPO=stateway-io/stateway-issues
AGENT_URL=http://localhost:8080
